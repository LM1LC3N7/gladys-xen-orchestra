{
  "name": "gladys-xen-orchestra",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for Xen Orchestra / XCP-ng: hosts, VMs (state, CPU, memory), storage repositories and backup runs through the XO REST API over HTTPS with a pinned certificate; start a VM, shut down / force / restart behind options. Unofficial, not affiliated with Vates.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-xen-orchestra.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
